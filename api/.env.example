APP_NAME=Cost-Tracker
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Public URL of the web app (used in mail links: invitation, password reset)
FRONTEND_URL=http://localhost:8081

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: SQLite (default) or MySQL via DDEV. Production: MySQL from the Netcup panel.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cost_tracker
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No long-running workers on the webspace: the scheduler runs queue:work --stop-when-empty
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local: log mails. Production: SMTP via Netcup mailbox.
MAIL_MAILER=log
# MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mxe9bf.netcup.net
MAIL_PORT=465
MAIL_USERNAME=kosten@codekorb.de
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="kosten@codekorb.de"
MAIL_FROM_NAME="${APP_NAME}"

# Android App Links (/.well-known/assetlinks.json): SHA-256 fingerprint(s) of the signing certificate, comma-separated
ANDROID_PACKAGE_NAME=de.codekorb.kosten
ANDROID_SHA256_CERT_FINGERPRINTS=

# Expo push (optional access token if "enhanced push security" is enabled in Expo)
EXPO_ACCESS_TOKEN=
